      object Label4: TLabel
        Left = 488
        Height = 15
        Top = 16
        Width = 32
        Caption = 'Help :'
        Font.Style = [fsBold]
        ParentFont = False
      end
      object Memo2: TMemo
        Left = 488
        Height = 208
        Top = 40
        Width = 288
        Lines.Strings = (
          '     Cryptography using Newton-Raphson method as Finding Root'
          'of Polynomial'
          ''
          '-Using single key 16 digits decimal.'
          ''
          '-Polynomial with 4 terms. '
          'F(x) = c1*(x)^d1 + c2*(x)^d2 + c3*(x)^d3 + c4*(x)^d4'
          ''
          '-Position digit decimal on key, from 1 to 16, coefficient 1(digit 1-3), degree 1(digit 4), coef 2(digit 5-7), degree 2(digit 8),  coef 3(digit 9-11), degree 3(digit 12) and coef 4(digit ,13-15), degree 4(digit 16).'
          '-Can use any 16 digit decimal, e.g 3925194768015297'
          '-Input ordinal number from character in ASCII to Polynomial F(x), so we got value as constant. Example  ord(A)=65, so got value of const on a given ordinal of char.'
          '-Thus  c1*(x)^d1 + c2*(x)^d2 + c3*(x)^d3 + c4*(x)^d4 = C ; C is const.'
          '  or  c1*(x)^d1 + c2*(x)^d2 + c3*(x)^d3 + c4*(x)^d4 - C = 0 . '
          ''
          '-Now we have a Finding-Root problem.'
          '-In this case, I use Newton-Raphson method to solve the problem.'
          '-As the final result we had the root in the ordinal number after using Newton-Raphson method.'
          ' In the example above the root is 65(char A).'
          '-The same way, we can apply to the message that is the string of chars.'
          '-The others are just String operations..'
          '-To view purposes, decimal string encodeded to Base64 on menu Encryption.'
          '- Finally chiper Base64 text format reverse back to decimal string on menu Decryption, and solve all the roots problem'
          '-That’s it that’s all.'
          ''
          'How to use:'
          '-Just click an example on the menu Eecryption & run.'
          '-Copy & paste key & chipertext to menu Decryption & run.'
          ''
          'Notes:'
          '-It''s open sourcecode, feel free to use & modify. '
          '-still got short message capacity.'
        )
        ParentFont = False
        ReadOnly = True
        ScrollBars = ssAutoVertical
        TabOrder = 8
      end
