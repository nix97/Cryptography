    object Memo2: TMemo
      Left = 464
      Height = 186
      Top = 32
      Width = 320
      Lines.Strings = (
        'Ilustration: '
        ''
        '-Nix wants to send a message to Eyin '
        '-Eyin got pair of key (public key & private key).'
        '-Public key (e), pair with n that not secret.'
        '-Private key (d) is a secret.'
        '-With public key(n,e), Nix encrypt the message,'
        ' as the result a secret text/chiper text(on the form of numbers).'
        '-Then the message delivered.'
        '-With her private key, Eyin reveal the secret message'
        '  from chiper text to clear text.  '
        '-That''s it.'
        ' '
        'Steps:'
        ''
        '-Generate prime number ( for example from 1000 to '
        '2000) '
        'then Run.'
        '-For Generate Key:  add prime number to p , q , e ;'
        '-For example p=1931 ; q=1997 ; e=1051; '
        '-After run you got d , n ;'
        '-p (secret); q (secret); n (not secret).  '
        '-e is Public key (not secret) ;'
        '-d is Private key (secret : keep it secretly) ;'
        '-If you input  p=1931 ; q=1997 ; e=1051; then you got'
        '  n =3856207 ; d=1488131 ;'
        '-After got n, e, d then use n , e for Encryption ;'
        '-Use n , d for Decryption ; '
        '-After got Encrypted text (from menu Encryption)'
        '  then copy & paste to Encrypted text in menu '
        'Decryption ;   '
        ' '
        '-Finally you got clear text.'
        ''
        'Note:'
        'It takes time for running (maybe hours) for big keys. '
        'Ignore the warning "Not Responding" (it''s still run).'
      )
      ParentFont = False
      ReadOnly = True
      ScrollBars = ssAutoBoth
      TabOrder = 5
    end
  end
