    object Memo2: TMemo
      Left = 464
      Height = 186
      Top = 32
      Width = 320
      Lines.Strings = (
        'Ilustration: '
        ''
        '-Bob wants to send a message to Alice. '
        '-Alice got pair of key (public key & private key).'
        '-Public key (e) is not secret (any one can see).'
        '-Private key (d) is secret.'
        '-With public key from Alice, Bob encrypt the message'
        ' (means He convert a message from clear text to '
        '  secret text).'
        '-Then the message delivered.'
        '-With her private key, Alice convert the secret message'
        '  from encrypted text to clear text.  '
        '-That''s it.'
        ' '
        'Steps:'
        ''
        '-Generate prime number ( for example from 1000 to 2000) '
        'then Run.'
        '-For Generate Key:  add prime number to p , q , e ;'
        '-For example p=1931 ; q=1997 ; e=1051; '
        '-After run you got d , n ;'
        '-e is Public key (not secret) ;'
        '-d is Private key (secret : keep it secretly) ;'
        '-If you input  p=1931 ; q=1997 ; e=1051; then you got'
        '  n =3856207 ; d=1488131 ;'
        '-After got n, e, d then use n , e for Encryption ;'
        '-Use n , d for Decryption ; '
        '-After got Encrypted text (from menu Encryption)'
        '  then copy & paste to Encrypted text in menu Decryption ;   '
        ' '
        '-Finally you got clear text.'
      )
      ScrollBars = ssAutoBoth
      TabOrder = 5
    end
  end
